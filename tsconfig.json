{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "./dist"
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "api/**/*"],
  "exclude": ["node_modules", "dist", ".vercel"]
}
